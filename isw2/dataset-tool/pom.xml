<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>isw2.openjpa</groupId>
    <artifactId>dataset-tool</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>ISW2 Dataset Tool</name>
    <description>Milestones 1-4 of the Falessi module on Apache OpenJPA</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- JSON parsing for the JIRA REST API. Same library as the code
             handed out in Milestone 1 (RetrieveTicketsID / getReleaseInfo). -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20260814</version>
        </dependency>

        <!-- Reading git history: tags, commits, diffs. -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
            <version>7.2.1.202505142326-r</version>
        </dependency>

        <!-- Silences JGit's "Failed to load class StaticLoggerBinder" warning.
             SLF4J is a logging facade; without a binding it prints this once and
             discards all log output. slf4j-nop makes that discarding explicit. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>1.7.36</version>
        </dependency>

        <!-- Milestone 2. weka-stable is the Maven Central artifact for the
             Weka 3.8.x line, which is the same line as the Weka 3-8-6 GUI the
             slides use ("C:/Program Files/Weka-3-8-6/..."). Matching the line
             matters: 3.9.x changed some filter defaults, so a result produced
             here would not reproduce in his GUI. -->
        <dependency>
            <groupId>nz.ac.waikato.cms.weka</groupId>
            <artifactId>weka-stable</artifactId>
            <version>3.8.6</version>
        </dependency>

        <!-- Milestone 2, supplementary comparison only. SMOTE is NOT part of
             core Weka - the slide itself says "if needed, download it at
             weka.sourceforge.io/packageMetaData/SMOTE". In the GUI that is the
             Package Manager; in Maven it is this separate artifact. -->
        <dependency>
            <groupId>nz.ac.waikato.cms.weka</groupId>
            <artifactId>SMOTE</artifactId>
            <version>1.0.3</version>
        </dependency>
    </dependencies>

</project>
